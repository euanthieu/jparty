# ─────────────────────────────────────────────────────────────────────────────
# FAOS Next.js Template — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values for your environment.
# NEVER commit .env.local to source control.
#
# All variables are validated by Zod at startup (src/shared/lib/env.ts).
# The app will throw a descriptive error if a required variable is missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
# Base URL of your backend REST API. Required.
# Example: http://localhost:3001 (local dev) | https://api.yourapp.com (prod)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical public URL of this frontend. Used for OG tags and sitemap.ts.
# Optional in development, required in production.
# Example: https://yourapp.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── App Environment ───────────────────────────────────────────────────────────
# Drives feature flag defaults and logging behavior.
# Must be one of: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# ── Upstash Redis (IGNYT CITY pre-order storage) ───────────────────────────────
# Create a free database at https://console.upstash.com → your DB → REST API tab.
# Needs a read+write token — a read-only token cannot save new orders.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Google Sheets order log (via Apps Script Web App) ───────────────────────────
# 1. Open the bound Apps Script on the pre-order Sheet (Extensions > Apps Script).
# 2. Paste in the doPost() handler (see project notes), set SHARED_SECRET to the
#    same value as GOOGLE_SHEETS_SHARED_SECRET below.
# 3. Deploy > New deployment > Web app > Execute as: Me > Who has access: Anyone.
# 4. Paste the resulting /exec URL below.
GOOGLE_SHEETS_WEBAPP_URL=
GOOGLE_SHEETS_SHARED_SECRET=
